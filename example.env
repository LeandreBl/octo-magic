# Copy to .env, next to docker-compose.yml.

# Firebase project of the logins (console: Project settings > General > Project ID).
# The server only verifies ID tokens: no service account needed.
FIREBASE_PROJECT_ID=
# Web API key (same page), handed to the game for the email/password login.
# Enable Authentication > Sign-in method > Email/Password in the console.
FIREBASE_API_KEY=

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# The forge (server/forge.py): Claude writes the spells, PixelLab draws them
# (optional, falls back to Claude's pixel grids).
ANTHROPIC_API_KEY=
PIXELLAB_TOKEN=
# FORGE_MODEL=claude-haiku-5-5

# Published port of the game and the API.
# PORT=8080
# Published port of the coop relay.
# RELAY_PORT=8770
# Relay URL handed to the game (default: ws://<server host>:8770). Behind
# HTTPS the web game needs a wss:// URL (a TLS proxy in front of the relay).
# RELAY_URL=wss://relay.example.com
