# Copy to .env, next to docker-compose.yml.

# Firebase project of the logins (console: Project settings > General > Project ID).
# The server only verifies ID tokens: no service account needed.
FIREBASE_PROJECT_ID=
# Web API key (same page), handed to the game for the email/password login.
# Enable Authentication > Sign-in method > Email/Password in the console.
FIREBASE_API_KEY=

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# The forge (server/forge.py): Claude writes the spells, PixelLab draws them
# (optional, falls back to Claude's pixel grids).
# Claude: an API key (console.anthropic.com), or for personal tests a Claude
# subscription: CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`, used when
# ANTHROPIC_API_KEY is empty. A subscription is not for serving other players.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
PIXELLAB_TOKEN=
# FORGE_MODEL=claude-haiku-5-5

# Published port of the game and the API.
# PORT=8080

# TURN server of the coop (coturn), for players behind strict NATs.
# Secret shared with the server, which hands out time-limited credentials.
# Generate with: openssl rand -hex 32
TURN_SECRET=
# Its public address, as the players reach it (the VPS's domain or IP).
# Empty: no TURN, peer to peer through STUN only.
# TURN_URL=turn:octo-magic.turn.notdotio.com:3478

# --- VPS behind Traefik ----------------------------------------------------------
# Uncomment on the VPS: `docker compose up -d --build` then uses the Traefik
# labels instead of publishing ports (docker-compose.override.yml is skipped).
# DNS: the three hosts point to the VPS (the TURN host is not behind Traefik).
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# GAME_HOST=octo-magic.notdotio.com
# API_HOST=octo-magic.api.notdotio.com
# TURN_URL=turn:octo-magic.turn.notdotio.com:3478
# Traefik's external Docker network, HTTPS entrypoint and certresolver.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
# Plain HTTP entrypoint (:80), which only redirects to HTTPS.
# TRAEFIK_HTTP_ENTRYPOINT=web
