// The online data of octo-magic. Tables and columns keep the names of the
// first server (backend/server.js), so its databases carry over as is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One of an account's characters, with its own profile (game/profile.gd,
/// Profile.to_dict()): gold, items, bonuses, look, stats, achievements...
model Character {
  id        String   @id @default(uuid())
  uid       String
  name      String
  spell     String   /// starting spell id (game/spells.json)
  profile   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([uid])
  @@map("characters")
}

/// A .spell bundle (zip) forged by a player.
model Spell {
  uid       String
  id        String
  bundle    Bytes
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([uid, id])
  @@map("spells")
}
